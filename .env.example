# Ultrademo environment. Copy this file to .env (which is gitignored) and fill in
# what you need. Everything here is optional - the pipeline runs without a .env,
# it just falls back to a free placeholder voice and no auto-login.
#
#   cp .env.example .env

# --- Narration -------------------------------------------------------------
# Best voice: an ElevenLabs API key. Without it, the pipeline uses Piper
# (free, offline) or the macOS `say` placeholder. Unchanged lines are cached,
# so re-renders never re-bill your quota.
ELEVENLABS_API_KEY=

# Optional voice tuning (a built-in demo voice is used if unset):
# ELEVENLABS_VOICE_ID=UM3TOcm5kcELI84GFoAz
# ELEVENLABS_STABILITY=0.45

# OpenRouter narration (Gemini TTS). When this key is set it is used ahead of
# ElevenLabs. Left empty, `npm run tts` stops and asks for it; delete the line
# to use the free Piper/say voice instead. Keys: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional (defaults shown). Changing any of these re-voices every line once.
# OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview
# OPENROUTER_TTS_VOICE=Gacrux
# Optional delivery direction in plain words, e.g. "Calm, friendly British
# narrator." Keep it to a sentence or two - long directions get read aloud.
# OPENROUTER_TTS_STYLE=
# Karaoke captions: each new line is transcribed once with word timestamps
# (about $0.003 per 30s) and the timings mapped onto the script. 'off' disables.
# OPENROUTER_TIMING_MODEL=fish-audio/transcribe-1

# --- App sign-in (optional) ------------------------------------------------
# For simple form logins, a flow's `setup` can read these instead of you
# pasting credentials into the chat. For SSO or anything with a human check,
# prefer `npm run login -- <profile> <url>` and sign in inside the window.
# APP_EMAIL=
# APP_PASSWORD=
